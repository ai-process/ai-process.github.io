  "cards": [
    {
      "dot": "emerald",
      "title": "Ingestion & Auth",
      "items": [
        "Bearer tokens configured as SHA-256 hashes: write for producers, read for reports, several at once for rotation",
        "Every event carries a UUID; duplicates are ignored, batches of up to 500 go in with one COPY"
      ]
    },
    {
      "dot": "cyan",
      "title": "ClickHouse Without Loss",
      "items": [
        "Each new event lands in clickhouse_outbox in the same statement; the replicator copies leased batches under a dedup token",
        "Outages and crashes only delay copying; reads fall back to Postgres, and /metrics shows the outbox lag"
      ]
    },
    {
      "dot": "violet",
      "title": "Reports for People & Assistants",
      "items": [
        "tokenmeter usage summary, top, by-meta and export, totals in exact USD",
        "Capped windows are fetched in parts, so totals are complete",
        "tokenmeter mcp only reads and refuses a token that can write"
      ]
    }
  ]
